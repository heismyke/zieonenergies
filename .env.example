# Copy to .env and fill in. Never commit real values.
APP_ENV=development            # development | test | pilot | production
PORT=8080
DATABASE_URL=postgres://zieon:zieon_dev@localhost:55432/zieon?sslmode=disable
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8080
EMBED_BASE_URL=http://localhost:5173
DEFAULT_TENANT=zenerlink
# openssl rand -base64 48
JWT_SIGNING_KEY=
JWT_KEY_ID=k1
# id:base64(32 bytes); add a new key and switch the active id to rotate
DATA_ENCRYPTION_KEYS=k1:
DATA_ENCRYPTION_KEY_ID=k1
PAYSTACK_SECRET_KEY=
SANDBOX_WEBHOOK_SECRET=
TRUST_PROXY_HEADERS=false
WORKERS_ENABLED=true
