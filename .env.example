# Copy to .env and fill in. Never commit real values.
APP_ENV=development            # development | test | pilot | production
PORT=8080
DATABASE_URL=postgres://zieon:zieon_dev@localhost:55432/zieon?sslmode=disable
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8080
EMBED_BASE_URL=http://localhost:5173
DEFAULT_TENANT=zenerlink
# openssl rand -base64 48
JWT_SIGNING_KEY=
JWT_KEY_ID=k1
# id:base64(32 bytes); add a new key and switch the active id to rotate
DATA_ENCRYPTION_KEYS=k1:
DATA_ENCRYPTION_KEY_ID=k1
PAYSTACK_SECRET_KEY=
SANDBOX_WEBHOOK_SECRET=
TRUST_PROXY_HEADERS=false
WORKERS_ENABLED=true
# MQTT device gateway (any listen address enables it; `api mqtt` runs it alone)
MQTT_TCP_ADDR=                    # lab only, e.g. 127.0.0.1:1883 (refused on public interfaces in production)
MQTT_TLS_ADDR=                    # e.g. :8883
MQTT_TLS_CERT_FILE=               # PEM path or glob
MQTT_TLS_KEY_FILE=
MQTT_WS_ADDR=                     # e.g. :8083, behind a TLS proxy as wss://host/mqtt
MQTT_PUBLIC_URLS=                 # comma-separated, returned at meter registration
# VTpass electricity aggregator for DisCo meters (empty API key = disabled).
# Sandbox tokens are test tokens; production refuses the sandbox URL.
VTPASS_BASE_URL=https://sandbox.vtpass.com   # live: https://vtpass.com
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_FALLBACK_PHONE=08011111111            # sent when a customer has no phone on file
