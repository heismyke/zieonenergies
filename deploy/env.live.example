# ~/apps/zieon-live/.env.live (chmod 600). PRODUCTION: real money. Never commit.
POSTGRES_PASSWORD=                 # openssl rand -hex 24
JWT_SIGNING_KEY=                   # openssl rand -base64 48 (different from staging)
JWT_KEY_ID=k1
DATA_ENCRYPTION_KEYS=k1:           # k1:$(openssl rand -base64 32) (different from staging)
DATA_ENCRYPTION_KEY_ID=k1
PUBLIC_BASE_URL=https://api.zenerlink.com
ALLOWED_ORIGINS=https://zenerlink.com,https://www.zenerlink.com
DEFAULT_TENANT=zenerlink
WORKERS_ENABLED=true
# Live providers (required: the API refuses to start in production without Paystack,
# and refuses the VTpass sandbox URL)
PAYSTACK_SECRET_KEY=sk_live_
VTPASS_BASE_URL=https://vtpass.com
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=PK_
VTPASS_SECRET_KEY=SK_
VTPASS_FALLBACK_PHONE=
# Used once by `api bootstrap`
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ORIGINS=https://zenerlink.com,https://www.zenerlink.com
SERVICE_FEE_KOBO=0                 # e.g. 10000 = ₦100 per purchase, shown to the buyer
