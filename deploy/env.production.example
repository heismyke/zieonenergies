# ~/apps/zieon/.env.production on the host (chmod 600). Never commit real values.
APP_ENV=pilot                     # pilot = sandbox vending/payments allowed; production disables them
POSTGRES_PASSWORD=                # openssl rand -hex 24
JWT_SIGNING_KEY=                  # openssl rand -base64 48
JWT_KEY_ID=k1
DATA_ENCRYPTION_KEYS=k1:          # k1:$(openssl rand -base64 32)
DATA_ENCRYPTION_KEY_ID=k1
PUBLIC_BASE_URL=https://zieon-api.198.199.65.142.sslip.io
EMBED_BASE_URL=https://zenerlink.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
DEFAULT_TENANT=zenerlink
SANDBOX_WEBHOOK_SECRET=           # openssl rand -hex 24 (pilot only)
PAYSTACK_SECRET_KEY=              # required when APP_ENV=production
# MQTT device gateway (any listen address enables it; `api mqtt` runs it alone)
MQTT_TCP_ADDR=                    # lab only, e.g. 127.0.0.1:1883 (refused on public interfaces in production)
MQTT_TLS_ADDR=                    # e.g. :8883
MQTT_TLS_CERT_FILE=               # PEM path or glob
MQTT_TLS_KEY_FILE=
MQTT_WS_ADDR=                     # e.g. :8083, behind a TLS proxy as wss://host/mqtt
MQTT_PUBLIC_URLS=                 # comma-separated, returned at meter registration
